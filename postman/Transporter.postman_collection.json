{
  "info": {
    "name": "FreightFox Transporter Assignment",
    "description": "Transporter Assignment on Lanes API. Run folders in order against a freshly started server (the \"No data\" request only returns 409 before any input has been submitted).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "0. No data submitted",
      "item": [
        {
          "name": "Assignment before any input -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"error shape\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\"error\"); pm.expect(b.message).to.be.a(\"string\"); pm.expect(b.timestamp).to.be.a(\"string\"); });",
                  "pm.test(\"message\", () => pm.expect(pm.response.json().message).to.eql(\"No input data submitted. Call /api/v1/transporters/input first.\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"maxTransporters\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transporters/assignment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transporters",
                "assignment"
              ]
            }
          }
        }
      ]
    },
